# -*- coding: utf-8 -*-
from pyrevit import revit, DB, script
import re

doc = revit.doc
output = script.get_output()

def get_type_name(wall_type):
    p = wall_type.get_Parameter(DB.BuiltInParameter.SYMBOL_NAME_PARAM)
    if p:
        return p.AsString()
    return DB.Element.Name.GetValue(wall_type)

def set_type_name(wall_type, new_name):
    p = wall_type.get_Parameter(DB.BuiltInParameter.SYMBOL_NAME_PARAM)
    if p and not p.IsReadOnly:
        p.Set(new_name)
    else:
        DB.Element.Name.SetValue(wall_type, new_name)

def normalize_generic_name(name):
    # Generic (7") -> Generic 7"
    new_name = re.sub(r"\(([^()]*)\)", r"\1", name)
    new_name = re.sub(r"\s+", " ", new_name).strip()
    return new_name

def wall_type_used(type_id):
    walls = DB.FilteredElementCollector(doc)\
        .OfClass(DB.Wall)\
        .WhereElementIsNotElementType()

    for wall in walls:
        if wall.GetTypeId() == type_id:
            return True
    return False

wall_types = list(
    DB.FilteredElementCollector(doc)
    .OfClass(DB.WallType)
    .WhereElementIsElementType()
)

types_by_name = {}
for wt in wall_types:
    wt_name = get_type_name(wt)
    if wt_name:
        types_by_name[wt_name] = wt

generic_paren_types = []
for wt in wall_types:
    wt_name = get_type_name(wt)
    if wt_name and wt_name.startswith("Generic") and "(" in wt_name and ")" in wt_name:
        generic_paren_types.append(wt)

changed_instances = 0
renamed_types = 0
deleted_types = 0
skipped = []

with revit.Transaction("Consolidate Generic Wall Types"):
    for source_type in generic_paren_types:
        source_name = get_type_name(source_type)
        target_name = normalize_generic_name(source_name)

        if target_name == source_name:
            continue

        target_type = types_by_name.get(target_name)

        if target_type and target_type.Id != source_type.Id:
            walls = DB.FilteredElementCollector(doc)\
                .OfClass(DB.Wall)\
                .WhereElementIsNotElementType()

            for wall in walls:
                if wall.GetTypeId() == source_type.Id:
                    try:
                        wall.ChangeTypeId(target_type.Id)
                        changed_instances += 1
                    except Exception as ex:
                        skipped.append(
                            "Could not change wall {} from '{}' to '{}': {}".format(
                                wall.Id, source_name, target_name, ex
                            )
                        )

            if not wall_type_used(source_type.Id):
                try:
                    doc.Delete(source_type.Id)
                    deleted_types += 1
                except Exception as ex:
                    skipped.append(
                        "Could not delete unused type '{}': {}".format(source_name, ex)
                    )

        else:
            try:
                set_type_name(source_type, target_name)
                types_by_name[target_name] = source_type
                renamed_types += 1
            except Exception as ex:
                skipped.append(
                    "Could not rename '{}' to '{}': {}".format(
                        source_name, target_name, ex
                    )
                )

output.print_md("## Generic Wall Type Consolidation Complete")
output.print_md("- Wall instances changed: **{}**".format(changed_instances))
output.print_md("- Wall types renamed: **{}**".format(renamed_types))
output.print_md("- Unused parenthetical wall types deleted: **{}**".format(deleted_types))

if skipped:
    output.print_md("## Skipped / Warnings")
    for item in skipped:
        output.print_md("- {}".format(item))